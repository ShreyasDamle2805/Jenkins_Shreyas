pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/ShreyasDamle2805/Jenkins_Shreyas.git'
            }
        }

        stage('Environment Setup') {
            steps {
                dir('flask-backend') {
                    sh '''
                        python3 -m venv venv
                        venv/bin/pip install --upgrade pip
                        venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('flask-backend') {
                    sh 'venv/bin/python -m pytest'
                }
            }
        }

        stage('Deploy Process') {
            steps {
                dir('flask-backend') {
                    sh '''
                        if pm2 describe flask-backend > /dev/null 2>&1; then
                            JENKINS_NODE_COOKIE=dontKillMe pm2 restart flask-backend
                        else
                            JENKINS_NODE_COOKIE=dontKillMe pm2 start "venv/bin/python app.py" --name flask-backend
                        fi
                        pm2 save
                        curl --fail --retry 10 --retry-delay 2 http://127.0.0.1:5000/api/health
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Flask Backend deployed successfully!'
        }
        failure {
            echo 'Flask Backend deployment failed.'
        }
    }
}
